 src/CMakeLists.txt               |   1 +
 src/wl_init.c                    |  16 +++
 src/wl_platform.h                |   5 +
 src/wl_window.c                  |  68 ++++++++++++-
 5 files changed, 251 insertions(+), 1 deletion(-)
 create mode 100644 deps/wayland/cursor-shape-v1.xml

