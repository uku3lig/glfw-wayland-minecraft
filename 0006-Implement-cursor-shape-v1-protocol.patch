+
 static void wmBaseHandlePing(void* userData,
                              struct xdg_wm_base* wmBase,
                              uint32_t serial)
@@ -225,6 +230,13 @@ static void registryHandleGlobal(void* userData,
                              &xdg_toplevel_icon_manager_v1_interface,
