     _GLFWofferWayland*          offers;
     unsigned int                offerCount;
@@ -655,6 +659,7 @@ typedef struct _GLFWcursorWayland
     int                         width, height;
     int                         xhot, yhot;
     int                         currentImage;
+    int                         shape;
 } _GLFWcursorWayland;
 
